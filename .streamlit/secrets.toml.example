# Copy to .streamlit/secrets.toml to try Google sign-in on your computer.
# (On Hugging Face, start.sh writes this file from the Space's secrets instead.)
# Never commit the real secrets.toml.

# Team members who can open 🎧 Voice check and see survey results
admins = ["you@gmail.com"]

[auth]
redirect_uri = "http://localhost:8508/oauth2callback"
# any long random text, e.g. from: python3 -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-with-a-long-random-string"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "replace-me"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
